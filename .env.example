# Copy to .env (or set these in Coolify's Environment Variables). All optional.

# Public address of the site, used for social-media link previews
SITE_URL=https://your-domain.com

# Lets you read contact messages at GET /api/messages with "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Get a Telegram ping for every new contact message
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Or get an email (Gmail: smtp.gmail.com, port 587, with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
